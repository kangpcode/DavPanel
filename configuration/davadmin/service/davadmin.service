[Unit]
Description=DavAdmin
After=network.target

[Service]
User=root
EnvironmentFile=-/etc/davpanel/environment
WorkingDirectory=/usr/local/davadmin/
ExecStart=/usr/local/davadmin/davadmin-amd64
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
